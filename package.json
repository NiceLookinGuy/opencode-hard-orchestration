{
  "name": "opencode-hard-orchestration",
  "displayName": "OpenCode Hard Orchestration",
  "description": "Hard-orchestration plugin for OpenCode: a delegate-only Commander agent with a permission hard gate, native subagent unblocking, and safety guards.",
  "version": "0.1.0",
  "author": "NiceLookinGuy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiceLookinGuy/opencode-hard-orchestration.git"
  },
  "homepage": "https://github.com/NiceLookinGuy/opencode-hard-orchestration",
  "bugs": {
    "url": "https://github.com/NiceLookinGuy/opencode-hard-orchestration/issues"
  },
  "keywords": [
    "opencode",
    "ai",
    "orchestrator",
    "hard-orchestration",
    "plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:dist": "node scripts/build.mjs",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.34"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "es-module-lexer": "^3.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
